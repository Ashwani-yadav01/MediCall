# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI & Voice Providers (Required only when VOICE_MODE=live)
GEMINI_API_KEY=
